# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
link-check-report.md
sheet-watch-report.md
sheet-watch.json
discover-report.md
discover.json

# MapLibre のワーカー（npm run dev / build の前に node_modules から置く）
/public/maplibre/

# Python のキャッシュ（scripts/ の作業用スクリプト）
__pycache__/

# 作業用（npm run legends などの中間ファイル）
/work/
