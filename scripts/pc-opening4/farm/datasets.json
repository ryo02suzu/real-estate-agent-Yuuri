{
  "_comment": "データセットの表。名前（world-* は world_fetch.py の SHOTS の名前を {arg} に入れる）→ 作り方。足すときはここに数行足すだけ。keyfiles はこれらの中身が変わると作り直す（scripts/pc-opening4 からの相対・* 可）。lane=serial は同じ取得先（タイル）を共有するので 1 つずつ順に作る。",
  "world-*": {
    "path": "work/world/{arg}",
    "cmds": ["python world_fetch.py work/world/{arg} --shot {arg} --cache work/world/tiles"],
    "keyfiles": ["world_fetch.py", "cameras.json", "config.py", "geo4.py"],
    "tiles": {"path": "work/world/tiles", "prefix": "op4-tiles-world"},
    "pip": "numpy scipy pillow",
    "apt": false,
    "lane": "serial",
    "timeout_min": 180
  },
  "globe": {
    "path": "work/globe",
    "cmds": [
      "python globe_fetch.py --data work/globe",
      "python globe_fetch.py --data work/globe --detail"
    ],
    "keyfiles": ["globe_fetch.py", "config.py"],
    "pip": "numpy scipy pillow",
    "apt": false,
    "lane": "parallel",
    "timeout_min": 240
  },
  "trees": {
    "path": "work/trees/library.blend",
    "cmds": ["python -m trees.library"],
    "keyfiles": ["trees/*.py", "trees/atlas/*", "trees/lodcal.json", "config.py"],
    "pip": "bpy==5.3.0 numpy scipy pillow OpenEXR",
    "apt": true,
    "lane": "parallel",
    "timeout_min": 120
  }
}
